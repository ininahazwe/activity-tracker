{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
    /* Pas d'alias "paths" ici : tsc ne les réécrit pas à l'émission,
       les require("@/...") échouent en production (MODULE_NOT_FOUND).
       Utiliser des chemins relatifs côté serveur. */
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
