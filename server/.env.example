# Copier ce fichier en .env et renseigner les vraies valeurs. Ne jamais committer .env.

# ─── Base de données ───
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE"

# ─── Serveur ───
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# ─── Authentification ───
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Limitation de débit ───
RATE_LIMIT_GLOBAL_MAX=1000

# ─── E-mails (API Gmail, OAuth2) ───
EMAIL_USER=techsupport@mfwa.org
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# ─── Assistant IA (chatbot) ───
GROQ_API_KEY=
ANTHROPIC_API_KEY=
